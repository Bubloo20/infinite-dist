# Team portal — optional overrides.
# Set these in Vercel → Project → Settings → Environment Variables.
# Everything works without them; these just let you change the passwords
# without touching code.

# Password workers use at /portal
WORKER_PASSWORD=

# Password for the admin dashboard at /portal/admin
ADMIN_PASSWORD=

# Random string used to sign portal session cookies.
# Set this in production — generate one with: openssl rand -hex 32
PORTAL_SECRET=

# POSTGRES_URL is injected automatically by Vercel when you attach a
# Postgres store (Project → Storage → Create Database → Postgres).
# The work_logs table is created on first write.
